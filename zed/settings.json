// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  "edit_predictions": {
    "provider": "zed",
    "open_ai_compatible_api": {
      // llama-server on 8013, see ~/.claude/docs/local-fim-models.md
      "api_url": "http://127.0.0.1:8013/v1/completions",
      "model": "Qwen3-Coder-30B-A3B-Instruct-Q8_0",
      "prompt_format": "qwen",
      "max_output_tokens": 64,
    },
  },
  "languages": {
    "Python": {
      "format_on_save": "on",
      "language_servers": [
        // Enable ty, disable the rest
        "ty",
        "!basedpyright",
        "!pyright",
        "!pylsp",
      ],
      "code_actions_on_format": {
        "source.organizeImports.ruff": true,
      },
      "formatter": {
        "language_server": {
          "name": "ruff",
        },
      },
    },
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry",
    },
  },
  "terminal": {
    "env": {
      "PATH": "\"...:/usr/bin:/bin:...\"",
    },
    "font_size": 17.0,
    "font_family": "Iosevka Mayukai Original",
    "blinking": "on",
  },
  "git": {
    "inline_blame": {
      "enabled": true,
    },
  },
  "relative_line_numbers": "enabled",
  "gutter": {
    "line_numbers": true,
  },
  "minimap": {
    "show": "always",
  },
  "cursor_blink": true,
  "cursor_animation" : {
    "enabled": true
  },
  "buffer_font_family": "Iosevka Mayukai Original",
  "auto_indent_on_paste": false,
  "semantic_tokens": "combined",
  "format_on_save": "off",
  "wrap_guides": [120],
  "session": {
    "trust_all_worktrees": true,
  },
  "vim_mode": true,
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 17.0,
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "Argent",
  },
  "experimental.theme_overrides": {
    // "editor.background": "#00000000",
    // "background": "#00000000",
    // "background.appearance": "transparent"
  },
}
