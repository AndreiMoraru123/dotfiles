" ============================================================
" .ideavimrc
" ============================================================

set VimEverywhere

" --- Options ---
set scrolloff=5
set incsearch
set visualbell
set showmode
set ideajoin
set number
set relativenumber

" --- Leader ---
let mapleader = " "

" --- Plugins ---
set textobj-indent
set highlightedyank
set NERDTree
set commentary
set sneak
set multiple-cursors
set surround
set peekaboo
set quickscope
let g:qs_highlight_on_keys = ['f', 'F', 't', 'T']

" ============================================================
" MAPPINGS — all Action mappings MUST use map/nmap/vmap/imap
" ============================================================

" Reload this config
nmap <leader>r <Action>(IdeaVim.ReloadVimRc.reload)

" Show error
map <C-e> <Action>(ShowErrorDescription)

" Accept autocomplete dropdown
imap <C-y> <Action>(EditorChooseLookupItem)

" Reformat
map \r <Action>(ReformatCode)

" Debug
map <leader>d <Action>(Debug)
map \b <Action>(ToggleLineBreakpoint)
map <leader>q <Action>(Stop)

" Debugging Navigation (from code.lua)
nmap <leader>c <Action>(Resume)
nmap <leader>n <Action>(StepOver)
nmap <leader>s <Action>(StepInto)
nmap <leader>o <Action>(StepOut)
nmap <leader>j <Action>(RunToCursor)
nmap <leader>R <Action>(Rerun)

" Python / Context Execution
nmap <leader>py <Action>(ContextRun)
nmap <leader>pd <Action>(ContextDebug)

" Go to next error
nmap ge <Action>(GotoNextError)

" Go to previous error
nmap gE <Action>(GotoPreviousError)

" Generate definitions (C++ only)
nmap gG <Action>(CppGenerateDefinitions)

" Go to declaration or usages (IdeaVim also defaults to this)
nmap gd <Action>(GotoDeclaration)

" Go to type declaration
nmap gD <Action>(GotoTypeDeclaration)

" Go to implementation (works with virtual methods, interfaces, etc.)
nmap gi <Action>(GotoImplementation)

" Go to super method (counterpart to gi, goes up the inheritance hierarchy)
nmap gI <Action>(GotoSuperMethod)

" Find usages
nmap gr <Action>(FindUsages)

" Go to symbol in file (Cmd-T is macos/jetbrains native for universal search, not in file)
nmap gO <Action>(FileStructurePopup)

" Switch between header and source files (C/C++)
nmap gh <Action>(SwitchHeaderSource)

" Show include hierarchy (C/C++)
nmap gH <Action>(CppIncludesHierarchy)

" Call hierarchy (Type hierarchy is <C-h> via IDE)
nmap gC <Action>(CallHierarchy)

" Code actions (lightbulb)
nmap <C-.> <Action>(ShowIntentionActions)

" --- Safe noremap mappings (no <Action>, so noremap is fine) ---
map Q gq

" Move lines in visual mode
vnoremap J :m '>+1<CR>gv=gv
vnoremap K :m '<-2<CR>gv=gv

" Paste without clobbering register
vnoremap <leader>p "_dP

" Yank/Paste to system clipboard
set clipboard+=unnamed
nnoremap <leader>Y gg"+yG

" Case toggles
nnoremap <Leader>u viwU
nnoremap <Leader>l viwu

" Multiple-Cursors (adapted from Zed)
nmap gl <Plug>NextWholeOccurrence
xmap gl <Plug>NextWholeOccurrence
nmap gL <Plug>RemoveOccurrence
xmap gL <Plug>RemoveOccurrence

nmap ga <Plug>AllWholeOccurrences
xmap ga <Plug>AllWholeOccurrences

xmap gA <Action>(EditorAddCaretPerSelectedLine)
xmap gI <Action>(EditorAddCaretPerSelectedLine)^

xmap g> <Plug>SkipOccurrence
xmap g< <Plug>RemoveOccurrence

